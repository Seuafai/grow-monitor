# Copy this file to .env.local and fill in your values.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# From your Firebase service account JSON (Project Settings > Service accounts):
FIREBASE_PROJECT_ID=black-betty-diary
FIREBASE_CLIENT_EMAIL=your-service-account@black-betty-diary.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE-HERE\n-----END PRIVATE KEY-----\n"

# Password that opens your diary:
APP_PASSWORD=choose-a-password

# Random secret used to sign your login cookie (any long random string):
APP_SECRET=change-me-to-a-long-random-string
